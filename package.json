{
  "name": "@mxwllstn/audio-player-react",
  "type": "module",
  "version": "0.1.0",
  "description": "React component for embedding audio files and streams",
  "author": "Max Stein <maxwell.stein@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/audio-player.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/audio-player.cjs"
      }
    }
  },
  "main": "./dist/audio-player.cjs",
  "module": "./dist/audio-player.mjs",
  "bin": "./cli.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm --filter audio-player-react-example dev",
    "build": "tsc --noEmit && vite build && unbuild && pnpm run compile",
    "typecheck": "tsc --noEmit",
    "compile": "tsx ./src/cli/compile.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dayjs": "^1.11.18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "tsx": "^4.20.5",
    "unbuild": "^3.6.1",
    "vite": "^5.4.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.0.2"
  }
}
